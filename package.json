{
  "name": "drop-beacon-mcp",
  "mcpName": "io.github.direct-web/drop-beacon-mcp",
  "version": "0.3.0",
  "description": "Read-only MCP for Drop Beacon public EDC catalog data. No database credentials required.",
  "type": "module",
  "bin": {
    "drop-beacon-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm test && npm run security:scan",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "security:scan": "node scripts/scan-secrets.mjs --tracked"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "edc",
    "everyday-carry",
    "drop-beacon",
    "knives",
    "flashlights",
    "fidgets"
  ],
  "author": "Drop Beacon <direct@edc4me.com>",
  "license": "MIT",
  "homepage": "https://edc4me.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/direct-web/drop-beacon-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
